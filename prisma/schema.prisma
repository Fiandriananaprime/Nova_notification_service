generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// userId is kept as a scalar UUID; the notification service does not create
// Prisma relations to users owned by another service.
// ---------------------------------------------------------------------------

enum NotificationChannel {
  email
  push
  sms

  @@map("notification_channel")
}

enum NotificationStatus {
  pending
  sent
  failed
  read

  @@map("notification_status")
}

model Notification {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  type        String
  channel     NotificationChannel
  title       String
  body        String
  metadata    Json                @default("{}")
  status      NotificationStatus  @default(pending)
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz(6)
  readAt      DateTime?           @map("read_at") @db.Timestamptz(6)
  failureReason String?           @map("failure_reason")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_user_date")
  @@index([status, createdAt(sort: Desc)], map: "idx_notifications_status_date")
  @@index([type, createdAt(sort: Desc)], map: "idx_notifications_type_date")
  @@map("notifications")
}
